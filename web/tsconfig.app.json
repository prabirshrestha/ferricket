{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun", "react"], "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "strict": true,
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] },
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx"
  },
  "include": ["src"]
}
